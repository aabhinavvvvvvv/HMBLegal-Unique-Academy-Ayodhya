# Public URL of the deployed site (used for canonical URLs, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Enquiry & contact forms are delivered through Web3Forms (https://web3forms.com).
# The school's public access key is built in (src/lib/web3forms.ts), so nothing is required here.
# Set this only to use a different Web3Forms form; set it to empty to switch Web3Forms off.
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Alternative delivery through Resend (https://resend.com). Used only when Web3Forms is switched off.
# If neither is configured, the forms validate input but tell visitors that
# online enquiries are not yet connected — they never pretend a message was sent.
RESEND_API_KEY=
# Inbox that receives enquiries (the school's email address)
ENQUIRY_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Unique Academy Website <website@your-domain.example>"
ENQUIRY_FROM_EMAIL=
